{
  "outputDirectory": ".",
  "buildCommand": "",
  "rewrites": [
    { "source": "/교과서/:path*", "destination": "/dist/교과서/:path*" },
    { "source": "/부교재/:path*", "destination": "/dist/부교재/:path*" },
    { "source": "/모의고사/:path*", "destination": "/dist/모의고사/:path*" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ]
}

#!/bin/sh

# ⛔ HTML 테스트 파일 커밋 차단 (index.html만 허용)
HTML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.html$' | grep -v 'index.html' | grep -v 'node_modules' || true)
if [ -n "$HTML_FILES" ]; then
  echo "⛔ HTML 파일 커밋 금지. 테스트는 JSON만 만드세요."
  echo "$HTML_FILES"
  exit 1
fi

# ⛔ dist/ 폴더 커밋 차단
DIST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^dist/' || true)
if [ -n "$DIST_FILES" ]; then
  echo "⛔ dist/ 폴더 커밋 금지."
  exit 1
fi

# ⛔ engine.js / engine.css 커밋 차단
ENGINE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'engine\.(js|css)' || true)
if [ -n "$ENGINE_FILES" ]; then
  echo "⛔ engine.js/css 커밋 금지."
  exit 1
fi

# ⛔ JSON 정답 정합성 검증 — det↔ans 불일치 시 커밋 차단
JSON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.json$' | grep '^data/' || true)
if [ -n "$JSON_FILES" ]; then
  FAIL=0
  for f in $JSON_FILES; do
    if [ -f "$f" ]; then
      node validate/validate-ans.js "$f" > /dev/null 2>&1
      if [ $? -ne 0 ]; then
        FAIL=1
        echo "⛔ det↔ans 불일치: $f"
        node validate/validate-ans.js "$f" 2>&1 | grep '\[S\]'
      fi
    fi
  done
  if [ $FAIL -ne 0 ]; then
    echo ""
    echo "⛔ 정답 오류 있는 JSON이 있습니다. ans를 수동으로 수정하지 마세요."
    echo "   → node validate/auto-ans.js <file> 로 AI 자동 생성하세요."
    exit 1
  fi
fi

# ⛔ validate.js S급 검증 (53 checks) ──
STAGED_JSON=$(git diff --cached --name-only --diff-filter=ACM | grep '^data/.*\.json$' || true)
if [ -n "$STAGED_JSON" ]; then
  echo "🔍 validate.js S급 검증 중..."
  VRESULT=$(node validate/validate.js $STAGED_JSON 2>&1)
  S_ERRORS=$(echo "$VRESULT" | grep -c '\[S\]' || true)
  A_ERRORS=$(echo "$VRESULT" | grep -c '\[A\]' || true)
  if [ "$S_ERRORS" -gt 0 ]; then
    echo "❌ validate.js FAIL: S급 $S_ERRORS건"
    echo "$VRESULT" | grep '\[S\]'
    echo ""
    echo "⛔ S급 에러가 있으면 커밋할 수 없습니다. 데이터를 수정하세요."
    exit 1
  fi
  if [ "$A_ERRORS" -gt 0 ]; then
    echo "⚠️  validate.js 경고: A급 $A_ERRORS건 (커밋 허용, 재출제 시 개선 필요)"
  fi
  echo "✅ validate.js PASS"
fi

# ⛔ 신규 파일 _meta 증적 검증 ──
NEW_JSON=$(git diff --cached --name-only --diff-filter=A | grep '^data/.*\.json$' || true)
if [ -n "$NEW_JSON" ]; then
  echo "🔍 신규 파일 _meta 증적 검증..."
  for f in $NEW_JSON; do
    HAS_META=$(node -e "const d=JSON.parse(require('fs').readFileSync('$f','utf8'));console.log(d._meta&&d._meta.generator&&d._meta.sopSteps?'OK':'FAIL')" 2>/dev/null || echo "FAIL")
    if [ "$HAS_META" != "OK" ]; then
      echo "❌ $f: _meta.generator 또는 _meta.sopSteps 필드 없음"
      echo "⛔ 신규 JSON 파일은 반드시 _meta 증적이 있어야 합니다."
      echo "   npm run generate로 출제하면 자동으로 추가됩니다."
      exit 1
    fi
  done
  echo "✅ _meta 증적 확인 완료"
fi

# ⛔ ans 수동 수정 감지 — validate-ans를 통과하지 않은 ans 변경 차단
ANS_CHANGED=$(git diff --cached -U0 -- 'data/*.json' | grep -E '^\+.*"ans":\s*[0-9]' || true)
if [ -n "$ANS_CHANGED" ]; then
  echo "ℹ️  ans 필드 변경 감지됨 — validate-ans 통과 확인 완료"
fi

# ⛔ QA 리포트 존재 확인 — data/ 변경 시 대응 리포트 필수
if [ -n "$JSON_FILES" ]; then
  MISSING_REPORTS=""
  for f in $JSON_FILES; do
    REPORT_DIR=$(echo "$f" | sed 's|^data/|reports/|' | sed 's|/[^/]*\.json$||')
    BASENAME=$(basename "$f" .json)
    REPORT_EXISTS=$(ls ${REPORT_DIR}/${BASENAME}_*.json 2>/dev/null | head -1)
    if [ -z "$REPORT_EXISTS" ]; then
      MISSING_REPORTS="$MISSING_REPORTS\n  $f"
    fi
  done
  if [ -n "$MISSING_REPORTS" ]; then
    echo "⛔ QA 리포트 없는 JSON이 있습니다:"
    echo -e "$MISSING_REPORTS"
    echo ""
    echo "   → npm run qa -- <파일> 로 검수 후 커밋하세요."
    exit 1
  fi
fi

# ⚠️ validate.js 무단 수정 차단 ──
VALIDATE_CHANGED=$(git diff --cached --name-only | grep '^validate/validate\.js$' || true)
if [ -n "$VALIDATE_CHANGED" ]; then
  echo "⚠️  validate.js 수정 감지"
  echo "   validate.js를 수정하려면 커밋 메시지에 [validate-update]를 포함하세요."
  echo "   무단 severity 낮추기는 금지입니다."
fi

# 📦 카탈로그 자동 동기화 — data/ 변경 시 index.html 카탈로그 자동 업데이트
if [ -n "$JSON_FILES" ]; then
  node scripts/auto-catalog.js 2>/dev/null
  # 카탈로그 변경됐으면 index.html도 스테이징
  if git diff --name-only index.html | grep -q index.html; then
    git add index.html
    echo "📦 카탈로그 자동 동기화됨 — index.html 업데이트"
  fi
fi

# 📦 test-deploy 자동 동기화 — data/ 변경 시 naesinfit-app의 test-deploy.ts 자동 업데이트
if [ -n "$JSON_FILES" ]; then
  DEPLOY_TS="../내신핏v21/app/src/shared/constants/test-deploy.ts"
  if [ -f "$DEPLOY_TS" ]; then
    node scripts/sync-test-deploy.js 2>/dev/null
    # 검증
    node scripts/sync-test-deploy.js --verify 2>/dev/null
    if [ $? -ne 0 ]; then
      echo "⛔ test-deploy.ts 동기화 검증 실패"
      exit 1
    fi
    echo "📦 test-deploy.ts 자동 동기화됨"
  fi
fi
